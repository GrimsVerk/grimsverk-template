# Enable with: {% if language == 'python' %}uv run {% endif %}pre-commit install
{% if language == 'python' -%}
# Keep the ruff rev in step with the ruff pin in pyproject.toml.
# mypy runs through `uv run` so it sees the project's dependencies, like CI.
repos:
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.15.22
    hooks:
      - id: ruff-check
      - id: ruff-format
  - repo: local
    hooks:
      - id: mypy
        name: mypy
        entry: uv run mypy
        language: system
        types: [python]
        pass_filenames: false
{%- else -%}
# Needs the tools installed: brew install swiftformat swiftlint
repos:
  - repo: local
    hooks:
      - id: swiftformat
        name: swiftformat (lint)
        entry: swiftformat --lint
        language: system
        types: [swift]
      - id: swiftlint
        name: swiftlint
        entry: swiftlint lint --strict --quiet
        language: system
        types: [swift]
{%- endif %}
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.30.1
    hooks:
      - id: gitleaks
