[project]
name = "{{ project_name }}"
version = "0.1.0"
# Not measured by ruff (TOML, not Python), so a long description is safe here —
# unlike the module docstring in src/, which is wordwrapped for that reason.
description = "{{ description | trim | replace('"', "'") }}"
readme = "README.md"
requires-python = ">=3.12"
# No `license` field, by design — see "Licensing" in AGENTS.md.
dependencies = []

[dependency-groups]
# Pinned to the same minor as the `rev` values in .pre-commit-config.yaml. An
# open lower bound here lets `uv sync` resolve a different ruff than pre-commit
# runs, and the two then disagree about formatting: green locally, red in CI,
# with no diff to explain why. Bump these and the pre-commit revs together.
dev = [
    "mypy~=2.3",
    # pre-commit is a dev dependency, not an assumed global: a fresh machine
    # or a hosted container has no `pre-commit` on PATH, and the README's
    # `uv run pre-commit install` step must work from `uv sync` alone (ESC-55).
    "pre-commit~=4.0",
    "pytest>=8.3",
    "ruff~=0.15.22",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM"]

[tool.mypy]
strict = true
mypy_path = "src"
files = ["src", "tests"]
