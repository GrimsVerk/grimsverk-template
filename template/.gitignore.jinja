.DS_Store
# Claude Code orchestration (transient; produced by .claude/scripts/spawn-worker.sh)
.claude/orchestration-logs/
# Delivery-driver run state and reports (transient; .claude/scripts/deliver-loop.sh)
.claude/deliver-loop/
# GitHub App credentials for the unattended driver's identity: the App ID and
# the PATH to its private key (.claude/scripts/app-token.sh reads it). Local to
# one machine and never committed — the .pem it points at must not be either.
.claude/app-identity
*.pem
# Worker worktrees live OUTSIDE .claude/, which Claude Code protects — a worker
# sandboxed under it is refused every write, silently. See spawn-worker.sh.
.worktrees/
{% if language == 'python' -%}
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
{%- else -%}
# Generated by XcodeGen from project.yml — never commit.
*.xcodeproj
xcuserdata/
DerivedData/
.build/
{%- endif %}
