{
  "_comment": "Optional Claude Code convenience layer — deleting the whole .claude/ directory leaves a fully functional project. Enforcement lives in pre-commit and CI; this hook only surfaces failures earlier, in-session, and the deny rules mirror the AGENTS.md branch discipline (no pushes to main, no force pushes, no history rewrites) for Claude Code sessions. Tradeoff: the hook runs after every file edit, so it is limited to fast operations{% if language == 'python' %} (format + quick test run){% else %} (format only — xcodebuild test is far too slow for a per-edit hook, so Swift tests run in CI and pre-push workflows instead){% endif %}.",
  "permissions": {
    "deny": [
      "Bash(git push origin main*)", "Bash(git push * main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push --force*)", "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": {% if language == 'python' %}"uv run ruff format --quiet . && uv run pytest -q -x >/dev/null 2>&1 || { echo 'post-edit checks failed — run: uv run pytest' >&2; exit 2; }"{% else %}"command -v swiftformat >/dev/null 2>&1 && swiftformat --quiet . || true"{% endif %}
          }
        ]
      }
    ]
  }
}
