{
  "permissions": {
    "deny": [
      "Bash(git push origin main*)", "Bash(git push * main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push --force*)", "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --no-verify*)", "Bash(git commit * --no-verify*)",
      "Bash(git push --no-verify*)", "Bash(git push * --no-verify*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": {% if language == 'python' %}"command -v uv >/dev/null 2>&1 && uv run ruff format --quiet . || true"{% else %}"command -v swiftformat >/dev/null 2>&1 && swiftformat --quiet . || true"{% endif %}
          }
        ]
      }
    ]
  }
}
