name: CI

# Fast checks on every push to main (agents run them locally before merging;
# this is the backstop). A newer push cancels the stale run.
on:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: {% raw %}ci-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: gitleaks/gitleaks-action@e0c47f4f8be36e29cdc102c57e68cb5cbf0e8d1e # v3.0.0
        env:
          GITHUB_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
{%- if language == 'python' %}
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          enable-cache: true
      - run: uv sync --locked
      - run: uv run ruff check .
      - run: uv run ruff format --check .
      - run: uv run mypy
      - run: uv run pytest
{%- else %}
      # iOS builds need macOS; they run in nightly.yml. Here: format and lint only.
      - name: Format
        run: docker run --rm -v "$PWD:/src" -w /src ghcr.io/nicklockwood/swiftformat:0.64.4 --lint .
      - name: Lint
        run: docker run --rm -v "$PWD:/src" -w /src ghcr.io/realm/swiftlint:0.65.1 lint --strict --quiet
{%- endif %}
