name: CI

# Push triggers on ALL branches: agents work on branches and may push many
# commits before a PR exists; every pushed commit gets CI (AGENTS.md).
on:
  push:
  pull_request:

jobs:
  # Mechanical precondition, not a code judgment: does this PR resolve to exactly
  # one plan? Kept a separate check from `review` on purpose — a red `plan` says
  # the branch/plan wiring is broken, where a red `review` would read as "the
  # reviewer rejected the code". Hard-fails: an estimate the reviewer never
  # receives is a gate that quietly stopped working. Branches with an exempt
  # prefix (chore/, docs/) pass without a plan. Always ubuntu — this is a text
  # match, and it must not sit behind a macOS runner on the Swift variant.
  plan:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Resolve the plan for this branch
        # GITHUB_HEAD_REF is the PR's source branch, set by Actions on
        # pull_request events.
        run: HEAD_REF="$GITHUB_HEAD_REF" .github/scripts/plan-resolve.sh

{% if language == 'python' %}
  checks:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v6
      - run: uv sync
      - run: uv run ruff check .
      - run: uv run ruff format --check .
      - run: uv run mypy
      - run: uv run pytest

  # The ratchet's one seeded check (AGENTS.md): revert the implementation, keep
  # the new tests, and fail if the suite still passes — tests that pass without
  # the code under test are testing nothing.
  test-the-tests:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          # Full history: the check diffs the PR against its merge base.
          fetch-depth: 0
      - uses: astral-sh/setup-uv@v6
      - run: uv sync
      - name: Tests must fail without the implementation
        # The SHAs are derived in the shell rather than from a GitHub Actions
        # expression on purpose: this file is a Jinja template, and Jinja would
        # consume a dollar-brace-brace expression before GitHub ever saw it.
        # Do not "simplify" this into the github.event.pull_request context.
        run: |
          BASE_SHA="$(git merge-base "origin/$GITHUB_BASE_REF" HEAD)" \
          HEAD_SHA="$(git rev-parse HEAD)" \
          .github/scripts/test-the-tests.sh
{% else %}
  test:
    # iOS builds require Xcode, so this job must run on a macOS runner —
    # Linux runners cannot build or test this target.
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v4
      # The .xcodeproj is generated, never committed; project.yml is the
      # source of truth, so CI regenerates the project first.
      - name: Generate Xcode project
        run: |
          brew install xcodegen
          xcodegen generate
      - name: Run tests
        # Unit tests for an iOS target need an iOS Simulator destination;
        # the device name must exist in the runner image's simulator list.
        # Signing is disabled — no provisioning is set up in CI.
        run: >
          xcodebuild test
          -project {{ app_name }}.xcodeproj
          -scheme {{ app_name }}
          -destination 'platform=iOS Simulator,name=iPhone 16'
          CODE_SIGNING_ALLOWED=NO

  # The ratchet's one seeded check (AGENTS.md): revert the implementation, keep
  # the new tests, and fail if the suite still passes — tests that pass without
  # the code under test are testing nothing. On Swift this is a blunter signal
  # than on Python: reverting Sources/ usually breaks compilation rather than
  # producing assertion failures. That still answers the question (the suite did
  # not pass), it just answers it crudely. Note this doubles macOS runner time on
  # every PR, which is the expensive runner.
  test-the-tests:
    if: github.event_name == 'pull_request'
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v4
        with:
          # Full history: the check diffs the PR against its merge base.
          fetch-depth: 0
      - run: brew install xcodegen
      - name: Tests must fail without the implementation
        # The SHAs are derived in the shell rather than from a GitHub Actions
        # expression on purpose: this file is a Jinja template, and Jinja would
        # consume a dollar-brace-brace expression before GitHub ever saw it.
        # Do not "simplify" this into the github.event.pull_request context.
        run: |
          BASE_SHA="$(git merge-base "origin/$GITHUB_BASE_REF" HEAD)" \
          HEAD_SHA="$(git rev-parse HEAD)" \
          .github/scripts/test-the-tests.sh
{%- endif %}
