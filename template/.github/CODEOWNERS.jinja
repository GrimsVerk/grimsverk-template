# CODEOWNERS — human ownership of the merge gates.
#
# Merges are mechanical: a PR merges when the required checks go green, with no
# human necessarily reading the code. That makes the paths below load-bearing —
# the pipeline must not be able to edit the things that check it. GitHub requires
# a review from the owner below before any change to these paths can merge, even
# under auto-merge. Keep this in sync with the required status checks in branch
# protection.
#
# For this to bind, the human must (once) enable branch protection on the default
# branch with "Require review from Code Owners" turned on. See the README.

# CI (hard gate), the review check + its prompt, the CODEOWNERS file itself, and
# the runner scripts all live under .github/ — one rule covers them.
/.github/                    {{ code_owner }}

# Pre-commit (git-level gate).
/.pre-commit-config.yaml     {{ code_owner }}

# Any root-level CODEOWNERS, in case one is added later.
/CODEOWNERS                  {{ code_owner }}

# The gates' INPUTS, which are load-bearing for exactly the same reason as the
# gates themselves. The review check judges each diff against these documents;
# left unowned, a pull request could rewrite the rule it violates, restate the
# design it diverges from, or adjust the estimates it overran, and the gate would
# grade it against the edited version. The scripts read them at the base commit
# so a single PR cannot do this — CODEOWNERS is what stops it being done in two.
/AGENTS.md                   {{ code_owner }}
/CLAUDE.md                   {{ code_owner }}
/docs/DESIGN.md              {{ code_owner }}
/docs/plans/                 {{ code_owner }}

# The append-only ledgers. Their value is that entries are never quietly
# revised — an escape edited out of the log is an escape that buys no check.
/docs/escapes.md             {{ code_owner }}
/docs/acceptance.md          {{ code_owner }}

# The Claude permission deny list. Vendor-specific and deletable, but while it
# exists an agent must not be able to widen its own permissions.
/.claude/settings.json       {{ code_owner }}
